# Copy this to .env.local and fill in your keys
# ─── Gemini (required) ───────────────────────────────────
# Get a free key at: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=AIzaSy_YOUR_KEY_HERE

# ─── Hugging Face (optional, for ML-based change detection) ──
# Get a free token at: https://huggingface.co/settings/tokens
VITE_HF_TOKEN=hf_YOUR_TOKEN_HERE

# ─── Bhashini (optional, for 22 Indian language translation) ─
# Sign up at: https://bhashini.gov.in/ulca → My Profile
VITE_BHASHINI_USER_ID=YOUR_USER_ID_HERE
VITE_BHASHINI_API_KEY=YOUR_ULCA_API_KEY_HERE
